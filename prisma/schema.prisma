generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UnilateralRefusal {
  id            Int     @id @default(autoincrement())
  regNumber     String
  region        String 
  inn           String?
  fullName      String?
  dataParsing   String?

  signDate    DateTime?
  publishDate DateTime?
  createdAt   DateTime  @default(now()) 
  updatedAt   DateTime  @updatedAt

  attachments   Attachment[]


  @@unique([regNumber, region])
  @@index([inn])
  @@index([regNumber])
  @@map("unilateral_refusals")
}


model Attachment {
  id         Int                @id @default(autoincrement())
  refusalId  Int
  fileName   String?            // Название файла
  url        String?            // Ссылка для скачивания
  refusal    UnilateralRefusal  @relation(fields: [refusalId], references: [id], onDelete: Cascade)
  
  @@map("attachments")
}